---
import logoRaw from "@/assets/logo.svg?raw";

import { buttonVariants } from "@/components/ui/button";
import { SITE_TITLE } from "@/consts";
import { cn } from "@/lib/utils";
import { Mail, Rss } from "lucide-react";
import HeaderLink from "./HeaderLink.astro";
import { Icons } from "./Icons";
import { MobileNav } from "./MobileNav";
import { ModeToggle } from "./ModeToggle";
import { SearchCommandDialog } from "./SearchCommandDialog";
---

<header
  class="border-border/40 bg-background/95 sticky top-0 z-50 w-full backdrop-blur-sm"
>
  <div class="container flex h-14 max-w-(--breakpoint-2xl) items-center">
    <MobileNav client:load />
    <a
      href="/"
      rel="home"
      aria-label={SITE_TITLE}
      class="brand-link group focus-visible:border-ring focus-visible:ring-ring/50 mr-4 flex items-center gap-2 rounded-md outline-none focus-visible:ring-[3px] lg:mr-6"
    >
      <span
        class="brand-logo text-primary inline-flex h-6 w-6 shrink-0 items-center [&>svg]:h-full [&>svg]:w-full"
        aria-hidden="true"
        set:html={logoRaw}
      />
      <span class="hidden items-baseline gap-2 md:flex">
        <span
          class="text-foreground group-hover:text-primary text-sm font-medium tracking-tight whitespace-nowrap transition-colors duration-200"
          >{SITE_TITLE}</span
        >
        <span
          class="text-muted-foreground group-hover:text-primary/70 hidden font-mono text-xs whitespace-nowrap transition-colors duration-200 xl:inline"
          >@rudeigerc</span
        >
      </span>
    </a>
    <div
      class="flex flex-1 items-center justify-between space-x-4 md:justify-end"
    >
      <div class="w-full flex-1 md:w-auto md:flex-none">
        <span class="sr-only">Search</span>
        <SearchCommandDialog client:load />
      </div>
      <nav class="hidden w-full space-x-4 md:flex md:w-auto">
        <HeaderLink href="/">Home</HeaderLink>
        <HeaderLink href="/posts">Blog</HeaderLink>
        <HeaderLink href="/about">About</HeaderLink>
      </nav>
      <nav class="flex items-center space-x-2">
        <a href="https://github.com/rudeigerc" target="_blank" rel="noreferrer">
          <div
            class={cn(
              buttonVariants({
                variant: "ghost",
              }),
              "h-9 w-9 px-0",
            )}
          >
            <span class="sr-only">GitHub</span>
            <Icons.github className="h-4 w-4" />
          </div>
        </a>
        <a href="https://x.com/yuchenrcheng" target="_blank" rel="noreferrer">
          <div
            class={cn(
              buttonVariants({
                variant: "ghost",
              }),
              "h-9 w-9 px-0",
            )}
          >
            <span class="sr-only">X</span>
            <Icons.x className="h-4 w-4" />
          </div>
        </a>
        <a
          href="mailto:rudeigerc@gmail.com"
          target="_blank"
          rel="noreferrer"
          class="hidden md:block"
        >
          <div
            class={cn(
              buttonVariants({
                variant: "ghost",
              }),
              "h-9 w-9 px-0",
            )}
          >
            <span class="sr-only">Mail</span>
            <Mail className="h-4 w-4" />
          </div>
        </a>
        <a
          href="/rss.xml"
          target="_blank"
          rel="noreferrer"
          class="hidden md:block"
        >
          <div
            class={cn(
              buttonVariants({
                variant: "ghost",
              }),
              "h-9 w-9 px-0",
            )}
          >
            <span class="sr-only">RSS</span>
            <Rss className="h-4 w-4" />
          </div>
        </a>
        <ModeToggle client:load />
      </nav>
    </div>
  </div>
</header>

<style>
  @reference "@/styles/global.css";

  .brand-logo {
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .brand-link:hover .brand-logo {
    transform: rotate(60deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-logo {
      transition: none;
    }

    .brand-link:hover .brand-logo {
      transform: none;
    }
  }
</style>
