---
import type { TocItem } from "@/lib/toc";
import { cn } from "@/lib/utils";

interface Props {
  toc: TocItem[];
  depth?: number;
}

const { toc, depth = 0 } = Astro.props;
---

<ul class={cn("m-0 list-none", { "pl-3 mt-0.5": depth !== 0 })}>
  {
    toc.map((heading) => (
      <li class="mt-0 py-0.5">
        <a
          href={`#${heading.slug}`}
          class={cn(
            "hover:text-foreground inline-block leading-snug no-underline transition-colors",
            depth === 0
              ? "text-muted-foreground text-sm"
              : "text-muted-foreground/60 hover:text-muted-foreground text-xs",
          )}
        >
          <span>{heading.text}</span>
        </a>
        {heading.children.length > 0 && (
          <Astro.self toc={heading.children} depth={depth + 1} />
        )}
      </li>
    ))
  }
</ul>
