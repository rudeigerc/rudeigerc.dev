---
import { Image } from "astro:assets";
import NotFoundImage from "@/assets/NotFound.png";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ArrowLeft } from "lucide-react";
---

<BaseLayout class="flex">
  <div class="m-auto flex flex-col place-items-center space-y-6">
    <Image
      src={NotFoundImage}
      alt="404 Not Found"
      width={NotFoundImage.width / 4}
    />
    <div class="flex flex-col items-center space-y-2">
      <p class="text-muted-foreground text-sm">
        This page doesn't exist or may have been moved.
      </p>
      <a
        href="/"
        class="text-primary flex items-center text-sm font-medium hover:underline hover:underline-offset-4"
      >
        <ArrowLeft className="mr-1.5 inline-block h-4 w-4" />
        Back to home
      </a>
    </div>
  </div>
</BaseLayout>
