---
import { Image } from "astro:assets";

import subscriptionImage from "@/assets/subscription.png";
import Giscus from "@/components/Giscus.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="About" description="About Yu-Chen Cheng.">
  <div class="prose py-6 lg:py-10">
    <h1>About</h1>

    <p>
      <strong>Yu-Chen Cheng</strong> is a software engineer at Tencent Cloud TI-ONE,
      focusing on building AI/LLM infrastructure based on Kubernetes.
      He holds M.Eng. and B.Eng. in software engineering from Shanghai Jiao Tong University.
    </p>

    <SocialLinks />

    <div class="not-prose mt-10">
      <Image
        src={subscriptionImage}
        alt="WeChat subscription"
        class="rounded-lg border shadow-sm"
      />
    </div>

    <Giscus />
  </div>
</BaseLayout>
